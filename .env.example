TELEGRAM_BOT_TOKEN=replace-me
OPENCODE_BASE_URL=http://127.0.0.1:49374
# OPENCODE_DIRECTORY=/path/to/your/project (recommended; otherwise uses last session's directory)
# REPOS_DIRECTORY=/path/to/your/repos (optional; lets you pick a repo folder when creating a session)
# ADMIN_TELEGRAM_USER_ID=123456789
# ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# LOG_LEVEL=info

# --- Docker / OpenCode server ---
# Password shared between the bot and the OpenCode HTTP server.
OPENCODE_SERVER_PASSWORD=replace-me
# Optional model provider keys (consumed by the opencode server container).
# OPENCODE_API_KEY=
# KILO_API_KEY=
# OpenCode Browse is OPTIONAL (useful on a desktop, pointless on a headless VPS).
# Set to true to install+enable it; rebuild with --build-arg ENABLE_BROWSE=1 too.
#   ENABLE_BROWSE=true docker compose up -d --build
# Install the extension: https://chromewebstore.google.com/detail/mfnicocicmmlkpjnaffgihfjhdgjkdjg
# Then: docker compose exec opencode browse pair  (enter code in extension options)
# ENABLE_BROWSE=false
# OPENCODE_BROWSER_AUTO_UPDATE=off
# Playwright MCP always runs headless Chromium in the container (no setup needed).
# MCP servers are generated at runtime by docker/entrypoint-opencode.sh.
# Voice notes (optional)
# A) whisper.cpp CLI (requires ffmpeg for non-wav formats):
# VOICE_TRANSCRIBER=/path/to/whisper.cpp/build/bin/whisper-cli
# VOICE_TRANSCRIBER_ARGS=["-m","/path/to/ggml-small.bin","-f","{input}","-otxt","-of","{output}"]
# B) HuggingFace model via the bundled Python wrapper (torch + transformers + librosa):
# VOICE_TRANSCRIBER=/path/to/opencodegram/transcribe_whisper.py
# VOICE_TRANSCRIPTION_LANGUAGE=auto
# VOICE_TRANSCRIPTION_TIMEOUT_MS=120000
# VOICE_ATTACH_AUDIO=false
# Persistent Whisper daemon (optional; lower latency after first load)
# WHISPER_DAEMON_URL=http://127.0.0.1:8877
# AUTO_CLEANUP_DAYS=0
# AUTO_RETRY_ENABLED=true
# AUTO_RETRY_MAX_ATTEMPTS=3
# AUTO_RETRY_MAX_AGE_MS=1800000
# RETRY_BACKOFF_BASE_MS=60000
# RETRY_BACKOFF_MAX_MS=900000
# RETRY_BACKOFF_FACTOR=2

# Operations
# OPS_PORT=9090
# OPS_HOST=127.0.0.1
# DISK_GUARD_MIN_FREE_MB=2048
# DISK_GUARD_PATH=/ai
# Private Mission Control web app (off unless a token is set)
# WEB_APP_TOKEN=
# WEB_APP_TITLE=Mission Control
# WEB_APP_URL=https://bot.example
# DEBUG=
# PILOT_PROJECT=

# Per-user rate limiting (disabled by default; monouser mode)
# USER_RATE_LIMIT_ENABLED=false
# USER_RATE_LIMIT_PER_MINUTE=30

# Agent backend (opencode or opencodex)
# AGENT_BACKEND=opencode
# OPENCODEX_BASE_URL=http://127.0.0.1:49374
