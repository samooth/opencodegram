TELEGRAM_BOT_TOKEN=replace-me
OPENCODE_BASE_URL=http://127.0.0.1:49374
# OPENCODE_DIRECTORY=/path/to/your/project (recommended; otherwise uses last session's directory)
# REPOS_DIRECTORY=/path/to/your/repos (optional; lets you pick a repo folder when creating a session)
# ADMIN_TELEGRAM_USER_ID=123456789
# ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# LOG_LEVEL=info

# --- Docker / OpenCode server ---
# Password shared between the bot and the OpenCode HTTP server.
OPENCODE_SERVER_PASSWORD=replace-me
# Optional model provider keys (consumed by the opencode server container).
# OPENCODE_API_KEY=
# KILO_API_KEY=
# Voice notes (optional; requires a local Whisper-compatible CLI and ffmpeg)
# VOICE_TRANSCRIBER=whisper-cli
# VOICE_TRANSCRIBER_ARGS=["-m","/models/ggml-base.bin","-f","{input}","-otxt","-of","{output}"]
# VOICE_TRANSCRIPTION_LANGUAGE=es
# VOICE_TRANSCRIPTION_TIMEOUT_MS=120000
# VOICE_ATTACH_AUDIO=false
# AUTO_CLEANUP_DAYS=0
# AUTO_RETRY_ENABLED=true
# AUTO_RETRY_MAX_ATTEMPTS=3
# AUTO_RETRY_MAX_AGE_MS=1800000
# RETRY_BACKOFF_BASE_MS=60000
# RETRY_BACKOFF_MAX_MS=900000
# RETRY_BACKOFF_FACTOR=2

# Operations
# OPS_PORT=9090
# OPS_HOST=127.0.0.1
# DISK_GUARD_MIN_FREE_MB=2048
# DISK_GUARD_PATH=/ai
# DEBUG=
# PILOT_PROJECT=

# Agent backend (opencode or opencodex)
# AGENT_BACKEND=opencode
# OPENCODEX_BASE_URL=http://127.0.0.1:49374
