TELEGRAM_BOT_TOKEN=replace-me
OPENCODE_BASE_URL=http://127.0.0.1:49374
# OPENCODE_DIRECTORY=/path/to/your/project (recommended; otherwise uses last session's directory)
# ADMIN_TELEGRAM_USER_ID=123456789
# ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
# LOG_LEVEL=info
# Voice notes (optional; requires a local Whisper-compatible CLI and ffmpeg)
# VOICE_TRANSCRIBER=whisper-cli
# VOICE_TRANSCRIBER_ARGS=["-m","/models/ggml-base.bin","-f","{input}","-otxt","-of","{output}"]
# VOICE_TRANSCRIPTION_LANGUAGE=es
# VOICE_TRANSCRIPTION_TIMEOUT_MS=120000
# VOICE_ATTACH_AUDIO=false
