FROM node:26-slim

ARG OPENCODE_VERSION=2.3.0
# Browse is optional (useful on a desktop, pointless on a headless VPS).
# Build with --build-arg ENABLE_BROWSE=1 to include it; runtime toggle is in .env.
ARG ENABLE_BROWSE=0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Base tools for a coding agent: git, fast search, shell utils, network/SSH,
# archives, diagnostics, and common native-build dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      git \
      ripgrep \
      fd-find \
      ca-certificates \
      curl \
      wget \
      openssh-client \
      jq \
      unzip \
      zip \
      xz-utils \
      tar \
      gzip \
      procps \
      lsof \
      less \
      file \
      diffutils \
      patch \
      make \
      build-essential \
      pkg-config \
      python3 \
      gnupg \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI (gh): useful for PR/issue/review workflows.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# OpenCode CLI (pinned). Installed at build time to avoid runtime npm installs.
RUN npm install -g "@opencode/cli@${OPENCODE_VERSION}" \
    && npm cache clean --force

# OpenCode Browse (optional): MCP server + Chromium extension that lets agents
# use the user's real browser (tabs, logins, clicks) from Telegram.
RUN if [ "$ENABLE_BROWSE" = "1" ] || [ "$ENABLE_BROWSE" = "true" ]; then \
      npm install -g "@opencode/browse" && npm cache clean --force; \
    else \
      echo "OpenCode Browse disabled at build time"; \
    fi

# Playwright MCP: headless Chromium for deterministic web debugging
# (accessibility snapshots, console/network logs, screenshots). Complements
# Browse: Playwright is isolated; Browse uses the user's real logged-in tabs.
RUN npm install -g "@playwright/mcp@0.0.85" \
    && npx playwright install chromium --with-deps \
    && npm cache clean --force

# Repositories are usually mounted from the host with a different owner.
RUN git config --system --add safe.directory '*'

WORKDIR /workspace

COPY docker/entrypoint-opencode.sh /usr/local/bin/entrypoint-opencode.sh
RUN chmod +x /usr/local/bin/entrypoint-opencode.sh

EXPOSE 49374

ENTRYPOINT ["/usr/local/bin/entrypoint-opencode.sh"]
CMD ["opencode", "serve", "--hostname", "0.0.0.0", "--port", "49374"]
