{
  "name": "opencodegram",
  "version": "0.7.1",
  "private": false,
  "type": "module",
  "description": "Remote control plane for OpenCode via Telegram",
  "main": "src/index.ts",
  "bin": {
    "opencodegram": "src/index.ts"
  },
  "files": [
    "src",
    "ecosystem.config.cjs",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "doctor": "bun run src/doctor.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p ."
  },
  "dependencies": {
    "@opencode/client": "2.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samooth/opencodegram"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "telegram",
    "bot",
    "control-plane",
    "bun"
  ]
}
